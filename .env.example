# Plantilla de variables de entorno.
# Copiala a .env.local y completá los valores. NO pongas secretos reales acá:
# este archivo SÍ se versiona, .env.local NO.

# ── Supabase (base de datos) ──────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── NextAuth (login del panel /admin) ─────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Cloudflare R2 (subida de imágenes) ────────────────────────────────────
# Opcional en desarrollo: sin esto, /api/upload/presign devuelve 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Resend (formulario de contacto) ───────────────────────────────────────
# Opcional en desarrollo: sin esto, /api/contact devuelve 503.
RESEND_API_KEY=

# ── Prisma (solo para correr migraciones) ─────────────────────────────────
# Cadena de conexión Postgres de Supabase.
DATABASE_URL=
